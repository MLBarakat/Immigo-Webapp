{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "src/**/*.json",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "amplify/functions/**/__tests__/**/*.ts",
    "eval/**/__tests__/**/*.ts",
    "eval/**/__tests__/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-node",
    "tests/e2e"
  ]
}
