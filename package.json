{
  "name": "immigo-webapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "node ./scripts/preinstall.js",
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "deploy": "npm run build && amplify push",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1113.0",
    "@aws-sdk/client-polly": "^3.1113.0",
    "@huggingface/transformers": "^3.7.6",
    "@opentelemetry/core": "2.0.0",
    "@ricky0123/vad-web": "^0.0.29",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/supabase-js": "^2.43.4",
    "@xenova/transformers": "2.17.2",
    "aws-amplify": "^6.4.3",
    "lucide-react": "^0.381.0",
    "onnxruntime-web": "1.19.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^4.0.13",
    "react-router-dom": "^6.23.1",
    "react-speech-recognition": "^3.10.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.2.1",
    "@aws-amplify/backend-cli": "^1.2.2",
    "@playwright/test": "^1.44.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.12.12",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^2.0.0",
    "@vitest/ui": "^2.0.0",
    "autoprefixer": "^10.4.19",
    "aws-cdk-lib": "^2.147.1",
    "constructs": "^10.3.0",
    "dotenv-cli": "^7.4.2",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.6",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.38",
    "rimraf": "^5.0.7",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.46.2",
    "vite": "^6.4.1",
    "vite-plugin-static-copy": "^3.1.4",
    "vitest": "^2.0.0"
  },
  "overrides": {
    "@xenova/transformers": "2.17.2",
    "onnxruntime-web": "1.19.2",
    "@opentelemetry/core": "2.0.0",
    "vite": "^6.4.1"
  }
