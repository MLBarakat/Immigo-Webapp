    "react-router-dom": "^6.23.1",
    "react-error-boundary": "^4.0.13",
    "react-speech-recognition": "^3.10.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.16.0",
